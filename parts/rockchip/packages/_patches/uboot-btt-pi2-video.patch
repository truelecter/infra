diff --git a/drivers/video/bridge/rpi-dsi-bridge.c b/drivers/video/bridge/rpi-dsi-bridge.c
new file mode 100644
index 000000000000..892eab7f4862
--- /dev/null
+++ b/drivers/video/bridge/rpi-dsi-bridge.c
@@ -0,0 +1,421 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Toshiba TC358762 DSI to DPI bridge of Raspberry Pi 7" touchscreen style
+ * displays, such as the BigTreeTech PiTFT.
+ *
+ * The bridge is a DSI peripheral of the host DSI controller and is exposed
+ * as a panel: it reports the timing of the DPI panel behind its port@1 and
+ * brings up the whole display. Display power, bridge/LCD reset and
+ * backlight are controlled by an ATtiny microcontroller on I2C, referenced
+ * by vddc-supply (and as GPIO controller by reset-gpios).
+ *
+ * Register sequences are taken from the Linux drivers
+ * drivers/gpu/drm/bridge/tc358762.c (Marek Vasut) and
+ * drivers/regulator/rpi-panel-attiny-regulator.c. Unlike Linux the bridge
+ * is driven in DSI burst mode, which gives the correct picture on the
+ * BigTreeTech PiTFT.
+ */
+
+#include <backlight.h>
+#include <dm.h>
+#include <i2c.h>
+#include <mipi_dsi.h>
+#include <panel.h>
+#include <dm/device_compat.h>
+#include <dm/ofnode_graph.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+
+/* TC358762 registers */
+#define PPI_STARTPPI		0x0104 /* START control bit */
+#define PPI_LPTXTIMECNT		0x0114 /* LPTX timing signal */
+#define PPI_D0S_ATMR		0x0144
+#define PPI_D1S_ATMR		0x0148
+#define PPI_D0S_CLRSIPOCOUNT	0x0164 /* Assertion timer for Lane 0 */
+#define PPI_D1S_CLRSIPOCOUNT	0x0168 /* Assertion timer for Lane 1 */
+#define PPI_START_FUNCTION	1
+#define DSI_STARTDSI		0x0204 /* START control bit of DSI-TX */
+#define DSI_LANEENABLE		0x0210 /* Enables each lane */
+#define DSI_RX_START		1
+#define LCDCTRL			0x0420 /* Video Path Control */
+#define LCDCTRL_VTGEN		BIT(4) /* Use chip clock for timing */
+#define LCDCTRL_UNK6		BIT(6) /* Unknown */
+#define LCDCTRL_RGB888		BIT(8) /* RGB888 mode */
+#define LCDCTRL_HSPOL		BIT(17) /* Polarity of HSYNC signal */
+#define LCDCTRL_VSPOL		BIT(19) /* Polarity of VSYNC signal */
+#define LCDCTRL_VSDELAY(v)	(((v) & 0xfff) << 20) /* VSYNC delay */
+#define SPICMR			0x0450
+#define SYSCTRL			0x0464
+#define LPX_PERIOD		3
+#define LANEENABLE_CLEN		BIT(0)
+#define LANEENABLE_L0EN		BIT(1)
+
+/* I2C registers of the ATtiny microcontroller */
+#define REG_ID			0x80
+#define REG_PORTA		0x81
+#define REG_PORTB		0x82
+#define REG_PORTC		0x83
+#define REG_POWERON		0x85
+#define REG_PWM			0x86
+#define REG_ADDR_L		0x8c
+#define REG_ADDR_H		0x8d
+#define REG_WRITE_DATA_H	0x90
+#define REG_WRITE_DATA_L	0x91
+
+#define PA_LCD_LR		BIT(2)
+#define PB_LCD_MAIN		BIT(7)
+#define PC_LED_EN		BIT(0)
+#define PC_RST_LCD_N		BIT(2)
+#define PC_RST_BRIDGE_N		BIT(3)
+
+#define ATTINY_ID_V1		0xde
+#define ATTINY_ID_V2		0xc3
+#define ATTINY_ID_TRIES		5
+#define ATTINY_WRITE_TRIES	10
+
+struct rpi_bridge_priv {
+	struct udevice *attiny;
+	struct display_timing timing;
+};
+
+static int attiny_write(struct udevice *attiny, u8 reg, u8 val)
+{
+	int ret, i;
+
+	for (i = 0; i < ATTINY_WRITE_TRIES; i++) {
+		ret = dm_i2c_reg_write(attiny, reg, val);
+		if (!ret)
+			return 0;
+	}
+
+	dev_err(attiny, "write 0x%02x to reg 0x%02x failed: %d\n", val, reg, ret);
+
+	return ret;
+}
+
+/* The ATtiny wants the register address and the read as separate transfers */
+static int attiny_read(struct udevice *attiny, u8 reg, u8 *val)
+{
+	struct dm_i2c_chip *chip = dev_get_parent_plat(attiny);
+	struct i2c_msg msg = {
+		.addr = chip->chip_addr,
+		.len = 1,
+	};
+	int ret;
+
+	msg.flags = 0;
+	msg.buf = &reg;
+	ret = dm_i2c_xfer(attiny, &msg, 1);
+	if (ret)
+		return ret;
+
+	mdelay(10);
+
+	msg.flags = I2C_M_RD;
+	msg.buf = val;
+
+	return dm_i2c_xfer(attiny, &msg, 1);
+}
+
+static int attiny_detect(struct udevice *attiny)
+{
+	u8 id = 0;
+	int ret = -ENODEV, i;
+
+	/* The first read after a warm reboot may return garbage */
+	for (i = 0; i < ATTINY_ID_TRIES; i++) {
+		if (i)
+			mdelay(30);
+
+		ret = attiny_read(attiny, REG_ID, &id);
+		if (ret)
+			continue;
+
+		if (id == ATTINY_ID_V1 || id == ATTINY_ID_V2)
+			return 0;
+
+		ret = -ENODEV;
+	}
+
+	dev_err(attiny, "no ATtiny found (last id 0x%02x, ret %d)\n", id, ret);
+
+	return ret;
+}
+
+/* Linux: attiny_i2c_probe() followed by attiny_lcd_power_enable() */
+static int attiny_power_on(struct udevice *attiny)
+{
+	int ret;
+
+	ret = attiny_detect(attiny);
+	if (ret)
+		return ret;
+
+	ret = attiny_write(attiny, REG_POWERON, 0);
+	if (ret)
+		return ret;
+	mdelay(30);
+
+	ret = attiny_write(attiny, REG_PWM, 0);
+	if (ret)
+		return ret;
+
+	/* Ensure bridge and touch controller stay in reset */
+	ret = attiny_write(attiny, REG_PORTC, 0);
+	if (ret)
+		return ret;
+	mdelay(10);
+
+	/* Same orientation as the closed source firmware */
+	ret = attiny_write(attiny, REG_PORTA, PA_LCD_LR);
+	if (ret)
+		return ret;
+	mdelay(10);
+
+	/* Main regulator on, and power to the panel (LCD_VCC_N low) */
+	ret = attiny_write(attiny, REG_PORTB, PB_LCD_MAIN);
+	if (ret)
+		return ret;
+	mdelay(10);
+
+	ret = attiny_write(attiny, REG_PORTC, PC_LED_EN);
+	if (ret)
+		return ret;
+	mdelay(80);
+
+	return 0;
+}
+
+/* Linux: attiny_gpio_set(RST_BRIDGE_N, 1), i.e. enable-gpios <&attiny 0> */
+static int attiny_release_bridge_reset(struct udevice *attiny)
+{
+	int ret;
+
+	ret = attiny_write(attiny, REG_PORTC,
+			   PC_LED_EN | PC_RST_BRIDGE_N | PC_RST_LCD_N);
+	if (ret)
+		return ret;
+	mdelay(8);
+
+	ret = attiny_write(attiny, REG_ADDR_H, 0x04);
+	if (ret)
+		return ret;
+	mdelay(8);
+
+	ret = attiny_write(attiny, REG_ADDR_L, 0x7c);
+	if (ret)
+		return ret;
+	mdelay(8);
+
+	ret = attiny_write(attiny, REG_WRITE_DATA_H, 0x00);
+	if (ret)
+		return ret;
+	mdelay(8);
+
+	ret = attiny_write(attiny, REG_WRITE_DATA_L, 0x00);
+	if (ret)
+		return ret;
+	mdelay(100);
+
+	return 0;
+}
+
+static int tc358762_write(struct mipi_dsi_device *dsi, u16 addr, u32 val)
+{
+	u8 data[6];
+	ssize_t ret;
+
+	data[0] = addr;
+	data[1] = addr >> 8;
+	data[2] = val;
+	data[3] = val >> 8;
+	data[4] = val >> 16;
+	data[5] = val >> 24;
+
+	ret = mipi_dsi_generic_write(dsi, data, sizeof(data));
+	if (ret < 0) {
+		dev_err(dsi->dev, "write 0x%08x to 0x%04x failed: %zd\n",
+			val, addr, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/* Linux tc358762_init() */
+static int tc358762_init(struct udevice *dev)
+{
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	struct rpi_bridge_priv *priv = dev_get_priv(dev);
+	struct mipi_dsi_device *dsi = plat->device;
+	u32 lcdctrl;
+	int ret;
+
+	ret = tc358762_write(dsi, DSI_LANEENABLE,
+			     LANEENABLE_L0EN | LANEENABLE_CLEN);
+	ret = ret ?: tc358762_write(dsi, PPI_D0S_CLRSIPOCOUNT, 5);
+	ret = ret ?: tc358762_write(dsi, PPI_D1S_CLRSIPOCOUNT, 5);
+	ret = ret ?: tc358762_write(dsi, PPI_D0S_ATMR, 0);
+	ret = ret ?: tc358762_write(dsi, PPI_D1S_ATMR, 0);
+	ret = ret ?: tc358762_write(dsi, PPI_LPTXTIMECNT, LPX_PERIOD);
+	ret = ret ?: tc358762_write(dsi, SPICMR, 0x00);
+	if (ret)
+		return ret;
+
+	lcdctrl = LCDCTRL_VSDELAY(1) | LCDCTRL_RGB888 |
+		  LCDCTRL_UNK6 | LCDCTRL_VTGEN;
+	if (priv->timing.flags & DISPLAY_FLAGS_HSYNC_LOW)
+		lcdctrl |= LCDCTRL_HSPOL;
+	if (priv->timing.flags & DISPLAY_FLAGS_VSYNC_LOW)
+		lcdctrl |= LCDCTRL_VSPOL;
+
+	ret = tc358762_write(dsi, LCDCTRL, lcdctrl);
+	ret = ret ?: tc358762_write(dsi, SYSCTRL, 0x040f);
+	if (ret)
+		return ret;
+	mdelay(100);
+
+	ret = tc358762_write(dsi, PPI_STARTPPI, PPI_START_FUNCTION);
+	ret = ret ?: tc358762_write(dsi, DSI_STARTDSI, DSI_RX_START);
+	if (ret)
+		return ret;
+	mdelay(100);
+
+	return 0;
+}
+
+/*
+ * Called by the DSI host after it has been set up and is in command mode
+ * (U-Boot's DSI host stops the HS clock for LP commands, so the bridge is
+ * programmed before video mode): power the display, release the bridge
+ * reset and program the bridge.
+ */
+static int rpi_bridge_enable_backlight(struct udevice *dev)
+{
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+	struct rpi_bridge_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	ret = mipi_dsi_attach(plat->device);
+	if (ret < 0)
+		return ret;
+
+	ret = attiny_power_on(priv->attiny);
+	if (ret)
+		return ret;
+
+	ret = attiny_release_bridge_reset(priv->attiny);
+	if (ret)
+		return ret;
+	mdelay(11);
+
+	return tc358762_init(dev);
+}
+
+/* Called by the DSI host once it streams video */
+static int rpi_bridge_set_backlight(struct udevice *dev, int percent)
+{
+	struct rpi_bridge_priv *priv = dev_get_priv(dev);
+	unsigned int pwm;
+
+	if (percent < 0 || percent > BACKLIGHT_MAX)
+		percent = BACKLIGHT_MAX;
+
+	pwm = DIV_ROUND_UP(percent * 0xff, BACKLIGHT_MAX);
+
+	return attiny_write(priv->attiny, REG_PWM, pwm);
+}
+
+static int rpi_bridge_get_display_timing(struct udevice *dev,
+					 struct display_timing *timing)
+{
+	struct rpi_bridge_priv *priv = dev_get_priv(dev);
+
+	*timing = priv->timing;
+
+	return 0;
+}
+
+static int rpi_bridge_of_to_plat(struct udevice *dev)
+{
+	struct rpi_bridge_priv *priv = dev_get_priv(dev);
+	struct ofnode_phandle_args args;
+	struct udevice *bus;
+	ofnode panel;
+	u32 addr;
+	int ret;
+
+	panel = ofnode_graph_get_remote_node(dev_ofnode(dev), 1, -1);
+	if (!ofnode_valid(panel)) {
+		dev_err(dev, "no panel on port@1\n");
+		return -EINVAL;
+	}
+
+	ret = ofnode_decode_panel_timing(panel, &priv->timing);
+	if (ret) {
+		dev_err(dev, "cannot decode panel-timing of %s: %d\n",
+			ofnode_get_name(panel), ret);
+		return -EINVAL;
+	}
+
+	ret = dev_read_phandle_with_args(dev, "vddc-supply", NULL, 0, 0, &args);
+	if (ret) {
+		dev_err(dev, "no vddc-supply: %d\n", ret);
+		return ret;
+	}
+
+	ret = ofnode_read_u32(args.node, "reg", &addr);
+	if (ret)
+		return ret;
+
+	ret = uclass_get_device_by_ofnode(UCLASS_I2C,
+					  ofnode_get_parent(args.node), &bus);
+	if (ret) {
+		dev_err(dev, "cannot get I2C bus of the ATtiny: %d\n", ret);
+		return ret;
+	}
+
+	ret = i2c_get_chip(bus, addr, 1, &priv->attiny);
+	if (ret) {
+		dev_err(dev, "cannot get ATtiny at 0x%02x: %d\n", addr, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int rpi_bridge_probe(struct udevice *dev)
+{
+	struct mipi_dsi_panel_plat *plat = dev_get_plat(dev);
+
+	/* Dual-lane mode does not work, same as in Linux */
+	plat->lanes = 1;
+	plat->format = MIPI_DSI_FMT_RGB888;
+	plat->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			   MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static const struct panel_ops rpi_bridge_ops = {
+	.enable_backlight = rpi_bridge_enable_backlight,
+	.set_backlight = rpi_bridge_set_backlight,
+	.get_display_timing = rpi_bridge_get_display_timing,
+};
+
+static const struct udevice_id rpi_bridge_ids[] = {
+	{ .compatible = "toshiba,tc358762" },
+	{ }
+};
+
+U_BOOT_DRIVER(rpi_dsi_bridge) = {
+	.name		= "rpi_dsi_bridge",
+	.id		= UCLASS_PANEL,
+	.of_match	= rpi_bridge_ids,
+	.ops		= &rpi_bridge_ops,
+	.of_to_plat	= rpi_bridge_of_to_plat,
+	.probe		= rpi_bridge_probe,
+	.plat_auto	= sizeof(struct mipi_dsi_panel_plat),
+	.priv_auto	= sizeof(struct rpi_bridge_priv),
+};
