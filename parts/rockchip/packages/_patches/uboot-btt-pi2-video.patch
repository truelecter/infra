BigTreeTech Pi 2 (RK3566): vidconsole on the BTT PiTFT DSI display, USB keyboard

Squashed on top of u-boot v2026.10 (apply with -p1):

- Daniel Golle, "[PATCH 0/9] video: rockchip: VOP2 and HDMI output for
  RK3568", patches 1-8 (9/9, the nanopi-r5c defconfig, is left out); the
  series carries Dang Huynh's VOP2, rk356x VOP pre-relocation, RK3568 HDMI
  and VPLL clock patches.
  https://patch.msgid.link/cover.1784424101.git.daniel@makrotopia.org
- Dang Huynh, "[PATCH 00/10] Rockchip VOP2 support", patches 1-3
  (dw-mipi-dsi: depend on VIDEO_BRIDGE, pixel clock calculation, proceed
  without external PHY; 2 and 3 by Ondrej Jirman), plus patch 6 "vop2: Add
  video bridge support" ported by hand onto the rk_vop2.c of Golle's series.
  https://patch.msgid.link/20250116-vop2-pt2-v1-0-c9d646b53930@riseup.net
- Local additions:
  - rk_vop2/rk3568_vop: DSI1 (MIPI1) output, selected by the VP endpoint
    reg; initialise the output-enable register value; map the frame
    buffer non-cacheable instead of flushing it.
  - dw_mipi_dsi_rockchip: call panel set_backlight once video mode is on.
  - drivers/video/bridge/rpi-dsi-bridge.c: TC358762 DSI-to-DPI bridge
    (DSI burst mode) as a DSI panel, with the Raspberry Pi 7" ATtiny
    power/reset/backlight controller (sequences from Linux tc358762.c
    and rpi-panel-attiny-regulator.c).
  - rk3566-bigtreetech-pi2-u-boot.dtsi: DSI1, D-PHY, VP1, I2C2, ATtiny,
    bridge and panel nodes (panel timing lives there).
  - configs/bigtreetech-pi2-rk3566_defconfig (VIDEO_REMOVE turns the
    window plane off before the OS takes over) and the board env file
    (stdin=serial,usbkbd).

diff --git a/arch/arm/dts/rk3566-bigtreetech-pi2-u-boot.dtsi b/arch/arm/dts/rk3566-bigtreetech-pi2-u-boot.dtsi
new file mode 100644
index 000000000000..01d9b508473e
--- /dev/null
+++ b/arch/arm/dts/rk3566-bigtreetech-pi2-u-boot.dtsi
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * BigTreeTech Pi 2 with the BigTreeTech PiTFT (Raspberry Pi 7" DSI display
+ * design) on DSI1: VOP2 VP1 -> DSI1 -> TC358762 DSI to DPI bridge -> 800x480
+ * DPI panel. Panel power, bridge reset and backlight are driven by the
+ * ATtiny microcontroller at I2C2 0x45.
+ */
+
+#include "rk356x-u-boot.dtsi"
+
+/ {
+	panel {
+		compatible = "panel-dpi";
+		power-supply = <&attiny>;
+		backlight = <&attiny>;
+		width-mm = <108>;
+		height-mm = <65>;
+
+		/* Panel timing: change it here */
+		panel-timing {
+			clock-frequency = <26000000>;
+			hactive = <800>;
+			vactive = <480>;
+			hfront-porch = <86>;
+			hsync-len = <18>;
+			hback-porch = <20>;
+			vfront-porch = <7>;
+			vsync-len = <1>;
+			vback-porch = <21>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+		};
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&bridge_out>;
+			};
+		};
+	};
+};
+
+&vp1 {
+	vp1_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
+		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
+		remote-endpoint = <&dsi1_in_vp1>;
+	};
+};
+
+&dsi_dphy1 {
+	status = "okay";
+};
+
+&dsi1 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	bridge@0 {
+		compatible = "toshiba,tc358762";
+		reg = <0>;
+		reset-gpios = <&attiny 0 GPIO_ACTIVE_HIGH>;
+		vddc-supply = <&attiny>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				bridge_in: endpoint {
+					remote-endpoint = <&dsi1_out_bridge>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				bridge_out: endpoint {
+					remote-endpoint = <&panel_in>;
+				};
+			};
+		};
+	};
+};
+
+&dsi1_in {
+	dsi1_in_vp1: endpoint {
+		remote-endpoint = <&vp1_out_dsi1>;
+	};
+};
+
+&dsi1_out {
+	dsi1_out_bridge: endpoint {
+		remote-endpoint = <&bridge_in>;
+	};
+};
+
+&i2c2 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	attiny: regulator@45 {
+		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
+		reg = <0x45>;
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
