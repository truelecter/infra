// BTT PiTFT50 on DSI1 of the BigTreeTech Pi 2.
// Chain: VOP2 VP1 -> DSI1 (1 lane, burst) -> TC358762 DSI->DPI bridge -> 800x480 panel.
// The panel MCU at I2C2 0x45 speaks the Raspberry Pi 7" ATtiny protocol: it powers the
// bridge and panel, drives the bridge reset and the backlight. The touch controller at 0x38
// has no interrupt line.
// The bridge driver must run in burst mode (tc358762-burst module), non-burst sync-pulse
// mode shifts the picture horizontally.

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&{/} {
	panel {
		// Radxa BSP 5-inch timing for the BTT TFT50 (also used by
		// github.com/saltydog101/rock3a_dsi on RK3568).
		compatible = "panel-dpi";
		power-supply = <&attiny>;
		backlight = <&attiny>;
		width-mm = <108>;
		height-mm = <65>;

		panel-timing {
			clock-frequency = <26000000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <86>;
			hsync-len = <18>;
			hback-porch = <20>;
			vfront-porch = <7>;
			vsync-len = <1>;
			vback-porch = <21>;
			hsync-active = <0>;
			vsync-active = <0>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&bridge_out>;
			};
		};
	};
};

&vp1 {
	vp1_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
		remote-endpoint = <&dsi1_in_vp1>;
	};
};

&dsi_dphy1 {
	status = "okay";
};

&dsi1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	bridge@0 {
		compatible = "toshiba,tc358762";
		reg = <0>;
		reset-gpios = <&attiny 0 GPIO_ACTIVE_HIGH>;
		vddc-supply = <&attiny>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				bridge_in: endpoint {
					remote-endpoint = <&dsi1_out_bridge>;
				};
			};

			port@1 {
				reg = <1>;

				bridge_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};
		};
	};
};

&dsi1_in {
	dsi1_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_dsi1>;
	};
};

&dsi1_out {
	dsi1_out_bridge: endpoint {
		remote-endpoint = <&bridge_in>;
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;

	attiny: regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	touchscreen@38 {
		compatible = "raspits_ft5426";
		reg = <0x38>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
	};
};
